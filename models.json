{
  "version": 1,
  "note": "Registry data. UI is built from this file (and from the optional Firestore document config/models, which admins can edit). Do not hardcode models in components.",
  "providers": {
    "puter": {
      "name": "Puter.js",
      "kind": "client",
      "docs": "https://docs.puter.com",
      "disclosure": "Your prompt (and any file text, photo or video frames you choose to use) is sent through Puter to the company that runs the selected model. It is processed outside CUTE-S AI, under Puter's and that company's own privacy policies. You may be asked to sign in to Puter."
    }
  },
  "defaults": {
    "images": "gpt-image-1",
    "files": "claude-sonnet-4-5",
    "videos": "togetherai:wan-ai/wan2.7-t2v",
    "coding": "claude-sonnet-4-5",
    "research": "claude-sonnet-4-5",
    "data": "claude-sonnet-4-5"
  },
  "models": [
    {
      "id": "claude-sonnet-4-5", "name": "Claude Sonnet 4.5", "provider": "puter", "vendor": "Anthropic",
      "categories": ["files", "coding", "research", "data", "videos"],
      "description": "Strong all-round model for writing, code, analysis and reasoning.",
      "capabilities": ["text", "code", "analysis", "vision"],
      "vision": true
    },
    {
      "id": "claude-sonnet-4", "name": "Claude Sonnet 4", "provider": "puter", "vendor": "Anthropic",
      "categories": ["files", "coding", "research", "data", "videos"],
      "description": "Previous-generation Claude model. Good all-round quality.",
      "capabilities": ["text", "code", "analysis", "vision"],
      "vision": true
    },
    {
      "id": "gpt-4o-mini", "name": "GPT-4o mini", "provider": "puter", "vendor": "OpenAI",
      "categories": ["files", "coding", "research", "data", "videos"],
      "description": "Fast and light. Best for quick tasks and short answers.",
      "capabilities": ["text", "code", "analysis", "vision"],
      "vision": true
    },
    {
      "id": "gpt-image-1", "name": "GPT Image", "provider": "puter", "vendor": "OpenAI",
      "categories": ["images"],
      "description": "High quality image generation with good prompt following and readable text.",
      "capabilities": ["text-to-image"],
      "images": { "qualities": ["low", "medium", "high"], "maxN": 4, "edit": false, "negativePrompt": false }
    },
    {
      "id": "dall-e-3", "name": "DALL·E 3", "provider": "puter", "vendor": "OpenAI",
      "categories": ["images"],
      "description": "Creative, illustration-friendly image generation.",
      "capabilities": ["text-to-image"],
      "images": { "qualities": [], "maxN": 4, "edit": false, "negativePrompt": false }
    },
    {
      "id": "gemini-2.5-flash-image-preview", "name": "Gemini Flash Image", "provider": "puter", "vendor": "Google",
      "categories": ["images"],
      "description": "Fast image generation. Can also edit a photo you add.",
      "capabilities": ["text-to-image", "image-edit"],
      "images": { "qualities": [], "maxN": 4, "edit": true, "negativePrompt": false }
    },
    {
      "id": "togetherai:wan-ai/wan2.7-t2v", "name": "Wan 2.7 (text to video)", "provider": "puter", "vendor": "Alibaba via Together AI",
      "categories": ["videos"],
      "description": "Text-to-video. Soundtrack is generated.",
      "capabilities": ["text-to-video"],
      "video": { "mode": "t2v", "seconds": { "min": 2, "max": 15, "default": 5 }, "sizes": ["720P", "1080P"], "ratios": ["16:9", "9:16", "1:1", "4:3", "3:4"], "negativePrompt": true, "audio": "always" }
    },
    {
      "id": "togetherai:wan-ai/wan2.7-i2v", "name": "Wan 2.7 (image to video)", "provider": "puter", "vendor": "Alibaba via Together AI",
      "categories": ["videos"],
      "description": "Animates a photo you add. A first-frame image is required.",
      "capabilities": ["image-to-video"],
      "video": { "mode": "i2v", "seconds": { "min": 2, "max": 15, "default": 5 }, "sizes": ["720P", "1080P"], "ratios": ["16:9", "9:16", "1:1", "4:3", "3:4"], "negativePrompt": true, "audio": "always" }
    },
    {
      "id": "seedance-2-0-mini", "name": "Seedance 2.0 mini", "provider": "puter", "vendor": "ByteDance (BytePlus)",
      "categories": ["videos"],
      "description": "Text-to-video, or animate a photo you add. Optional soundtrack.",
      "capabilities": ["text-to-video", "image-to-video"],
      "video": { "mode": "both", "seconds": { "min": 4, "max": 15, "default": 5 }, "sizes": ["720p", "480p"], "ratios": ["16:9", "9:16", "1:1", "4:3", "3:4"], "negativePrompt": false, "audio": "optional" }
    },
    {
      "id": "kling-3.0-turbo", "name": "Kling 3.0 Turbo", "provider": "puter", "vendor": "Kling",
      "categories": ["videos"],
      "description": "Text-to-video, or animate a photo you add. Soundtrack is always generated.",
      "capabilities": ["text-to-video", "image-to-video"],
      "video": { "mode": "both", "seconds": { "min": 3, "max": 15, "default": 5 }, "sizes": ["720p", "1080p"], "ratios": ["16:9", "9:16", "1:1"], "negativePrompt": false, "audio": "always" }
    },
    {
      "id": "gemini-omni-1.1-flash", "name": "Gemini Omni 1.1 Flash", "provider": "puter", "vendor": "Google",
      "categories": ["videos"],
      "description": "Text-to-video, image-to-video and video editing (source clip up to 10 s). The model chooses the clip length.",
      "capabilities": ["text-to-video", "image-to-video", "video-edit"],
      "video": { "mode": "both", "edit": true, "seconds": null, "sizes": ["360p", "720p", "1080p", "4k"], "ratios": ["16:9", "9:16"], "negativePrompt": false, "audio": "none" }
    }
  ]
}
